# Local dev env
.venv/
__pycache__/
*.pyc
.ruff_cache/

# Built binaries -- these are produced by CI (see .github/workflows/build-client.yml)
# or the build_*.sh/ps1 scripts, not hand-authored, and are large. The
# production server serves them from local disk independent of this repo.
windows/*.exe
windows/FileSortingManager.exe
linux/FileSortingUploader
macos/FileSortingUploader

# PyInstaller working directories/output -- regenerated by build/build_*.sh,
# not meant to be committed (can land at repo root or under build/ depending
# on where the script is invoked from).
*.spec
build/dist-*/
build/FileSortingUploader/
build/FileSortingManager/

# Local client config that may hold a token if `fsc configure` was ever run
# against this checkout
settings.json
